{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base", "group:allNonMajor", ":preserveSemverRanges", ":disablePeerDependencies"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchPackageNames": ["@napi/cli", "napi", "napi-build", "napi-derive"],
      "addLabels": ["napi-rs"],
      "groupName": "napi-rs"
    },
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": ["windows", "windows-core"],
      "groupName": "windows-rs",
      "minimumGroupSize": 2,
      "separateMajorMinor": false
    },
    {
      "matchPackagePatterns": ["^eslint", "^@typescript-eslint"],
      "groupName": "linter"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["@oxc-node/*"],
      "groupName": "oxc-node",
      "groupSlug": "oxc-node",
      "separateMajorMinor": false
    }
  ],
  "commitMessagePrefix": "chore: ",
  "commitMessageAction": "bump up",
  "commitMessageTopic": "{{depName}} version",
  "ignoreDeps": []
}
